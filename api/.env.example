# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres connection string.
#   Local:  postgres://USER@localhost:5432/bolt
#   Hosted: postgres://USER:PASSWORD@host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres@localhost:5432/bolt

# Browser origins allowed to call this API, comma-separated.
WEB_ORIGINS=http://localhost:5173

PORT=8080
NODE_ENV=development

# Optional. Without mail credentials the app runs exactly as before and codes
# are only shown on screen; with them they are also emailed, and code recovery
# is available.
#
# Gmail (preferred): delivers to any address, no domain needed. Requires
# 2-Step Verification, then create a password at
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Or Resend, used only when the Gmail pair is unset. Free tier at resend.com. Note that without a verified domain, Resend will only
# deliver to the address the account was created with.
RESEND_API_KEY=

# Resend only. Defaults to Resend's shared sender, which requires no domain.
EMAIL_FROM=Bolt Checkout <onboarding@resend.dev>
